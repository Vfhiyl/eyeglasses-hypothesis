                      var safeCookies = ['subscription_data'];
                      var cookies = document.cookie.split(';');
                      for (var i = 0; i < cookies.length; i++) {
                          var cookie = cookies[i].trim();
                          var eqPos = cookie.indexOf('=');
                          var cookieName = eqPos > -1 ? cookie.substr(0, eqPos) : cookie;
                          
                          // Protect AWS Cognito and Amplify cookies
                          var isCognito = cookieName.indexOf('CognitoIdentityServiceProvider') === 0 || cookieName.indexOf('aws-amplify') === 0;

